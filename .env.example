# Is file ko copy karke .env bana lo aur apni values daalo
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Cluster0
MONGODB_DB=hikmat
PORT=5000

# Admin login
JWT_SECRET=<kam az kam 32 random characters>
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<8+ characters>

# Optional: agar "mongodb+srv://" DNS error aaye (Pakistan ke kai ISPs par) to uncomment karo
# DNS_SERVERS=8.8.8.8,1.1.1.1
