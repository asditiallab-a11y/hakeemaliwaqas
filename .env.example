# ================= RAILWAY (server) - Variables mein ye daalo =================
NODE_ENV=production
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net
MONGODB_DB=hikmat
JWT_SECRET=kam-az-kam-32-characters-ki-lambi-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=pehli-baar-login-ke-baad-hata-do
# Railway Volume ka mount path (images/videos/PDF yahin save hongi, redeploy par ghayab nahi hongi)
DATA_DIR=/data
# Website ke domain(s) jinhein API use karne ki ijazat hai (comma se alag, aakhir mein "/" nahi)
CLIENT_ORIGIN=https://tumharidomain.com,https://www.tumharidomain.com
# API ka apna address (uploaded images ke links is se bante hain)
PUBLIC_API_URL=https://api.tumharidomain.com
# Sirf tab jab API ka domain website se alag "site" ho (jaise *.up.railway.app): none
# COOKIE_SAMESITE=none

# Articles ka auto English->Urdu translation (optional). Key na ho to ye feature band rehta hai.
# ANTHROPIC_API_KEY=sk-ant-...
# TRANSLATE_MODEL=claude-sonnet-5-5

# ================= LOCAL BUILD (frontend) - project root mein .env.production file banao =================
# VITE_API_URL=https://api.tumharidomain.com
